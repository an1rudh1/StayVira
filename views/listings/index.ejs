<% layout("/layouts/boilerplate")%>

<div class="row mt-3">
  <div class="col-12">
    <h3>Explore Stays</h3>
  </div>
</div>


<form method="GET" action="/listings" class="mb-4">
  <div class="row g-2 mt-1">
    <div class="col-md-3">
      <input
        type="text"
        name="location"
        class="form-control"
        placeholder="Where are you going?"
        value="<%= filters.location || '' %>"
      />
    </div>

    <div class="col-md-3">
      <input
        type="text"
        name="country"
        class="form-control"
        placeholder="Country"
        value="<%= filters.country || '' %>"
      />
    </div>

    <div class="col-md-2">
      <input
        type="number"
        name="minPrice"
        class="form-control"
        placeholder="Min &#8377;"
        value="<%= filters.minPrice || '' %>"
        min="0"
      />
    </div>

    <div class="col-md-2">
      <input
        type="number"
        name="maxPrice"
        class="form-control"
        placeholder="Max &#8377;"
        value="<%= filters.maxPrice || '' %>"
        min="0"
      />
    </div>

    <div class="col-md-1 d-grid">
      <button type="submit" class="btn btn-dark">Search</button>
    </div>

    <div class="col-md-1 d-grid">
      <a href="/listings" class="btn btn-outline-dark">Reset</a>
    </div>
  </div>
</form>

<%
  const hasFilters = (filters.location && filters.location.trim()) ||
                     (filters.country && filters.country.trim()) ||
                     filters.minPrice || filters.maxPrice;
%>


<% if(hasFilters) { %>
  <div class="d-flex flex-wrap gap-2 align-items-center mb-3">
    <% if(filters.location && filters.location.trim()) { %>
      <span class="badge rounded-pill bg-dark">
        <i class="fa-solid fa-location-dot me-1"></i><%= filters.location %>
      </span>
    <% } %>
    <% if(filters.country && filters.country.trim()) { %>
      <span class="badge rounded-pill bg-dark">
        <i class="fa-solid fa-earth-asia me-1"></i><%= filters.country %>
      </span>
    <% } %>
    <% if(filters.minPrice) { %>
      <span class="badge rounded-pill bg-dark">
        Min &#8377;<%= Number(filters.minPrice).toLocaleString("en-IN") %>
      </span>
    <% } %>
    <% if(filters.maxPrice) { %>
      <span class="badge rounded-pill bg-dark">
        Max &#8377;<%= Number(filters.maxPrice).toLocaleString("en-IN") %>
      </span>
    <% } %>
    <a href="/listings" class="btn btn-sm btn-outline-secondary">
      <i class="fa-solid fa-xmark me-1"></i>Clear
    </a>
  </div>
<% } %>

<p class="text-muted mb-3">
  <small><%= allListings.length %> stay<%= allListings.length !== 1 ? 's' : '' %> available</small>
</p>

<% if(allListings.length === 0) { %>
  <div class="col-8 offset-2 text-center mt-5">
    <i class="fa-regular fa-face-sad-tear" style="font-size: 3rem;"></i>
    <h5 class="mt-3">No stays found</h5>
    <p class="text-muted">Try searching a different location or adjusting your price range.</p>
    <a href="/listings" class="btn btn-dark mt-2">View all stays</a>
  </div>
<% } else { %>
  <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 row-cols-1">
    <% for(let listing of allListings) { %>
      <a class="listing-link" href="/listings/<%= listing._id %>">
        <div class="card col listing-card">
          <img
            src="<%= listing.image && listing.image[0] ? listing.image[0].url : '/img/placeholder.jpg' %>"
            class="card-img-top"
            alt="listing-image"
            style="height: 20rem; object-fit: cover;"
          />
          <div class="card-body">
            <p class="card-text">
              <b><%= listing.title %></b><br />
              <small class="text-muted">
                <i class="fa-solid fa-location-dot me-1"></i><%= listing.location %>, <%= listing.country %>
              </small><br />
              &#8377;<%= listing.price.toLocaleString("en-IN") %> / night
            </p>
          </div>
        </div>
      </a>
    <% } %>
  </div>
<% } %>